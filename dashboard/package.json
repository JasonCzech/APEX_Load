{
  "name": "apexload-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --outDir ../pkg/api/static --emptyOutDir",
    "bundle:check": "node ./scripts/run-bundle-budget.mjs",
    "contracts:generate": "cd .. && go run ./cmd/openapits -in docs/swagger.yaml -out dashboard/src/types/generated/openapi.ts",
    "contracts:check": "cd .. && go run ./cmd/openapits -in docs/swagger.yaml -out dashboard/src/types/generated/openapi.ts -check",
    "e2e": "playwright test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "lint:a11y": "node ./scripts/lint-accessibility.mjs",
    "test": "vitest run",
    "test:bundle-budget": "node --test ./scripts/check-bundle-budget.node-test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-virtual": "^3.14.5",
    "@uiw/react-codemirror": "^4.25.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.27.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright-core-go": "npm:playwright-core@1.57.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
