# Binaries and build artifacts
bin/
# Local Go tool cache (compiled, platform-specific plugins like protoc-gen-go).
.bin/
# Anchored to repo root so these match the compiled binaries only, not the
# cmd/controller, cmd/generator, cmd/apexctl, and cmd/dslschema source directories.
/controller
/generator
/apexctl
/main
# Compiled output of `go run ./cmd/dslschema`; the source lives in cmd/dslschema.
/dslschema
# Compiled output of `go run ./cmd/swaggergen`; the source lives in cmd/swaggergen.
/swaggergen
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof
dashboard/dist/
# Build-output binaries (desktop + recording-agent tarballs). These are release
# artifacts, not source — publish them as GitHub Release/CI assets. Already-tracked
# tarballs must be untracked once with: git rm --cached -r dist/
dist/
pkg/api/static/index.html
pkg/api/static/assets/
.playwright-cli/
.vite/

