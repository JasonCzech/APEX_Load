*.log
# Local runtime artifacts (recorder CA material, legacy archive output). Run
# archives now default outside the module tree (see config.DefaultArchiveDir);
# this entry stays so any stray in-tree artifacts/ never gets committed.
artifacts/

# Imported script fixtures should not be committed from local import testing
examples/*.jmx
examples/sample-import-*.json
examples/loadrunner/

# Playwright screenshot output
output/
playwright-report/
test-results/

# Generated deck output (source is deck_build/gen.js)
deck_build/*.pptx

# One-off local working files at the repo root — not part of the product
/files.zip
/apex-load-logo.png
/diff_*.txt
/patch_sla.go
/update_apexctl.py

# Local npm registry overrides. dashboard/.npmrc pins an internal Artifactory
# mirror that is unreachable from GitHub runners, so committing it breaks
# `npm ci` in ci.yml and release.yml. Keep it local; CI uses NPM_CONFIG_REGISTRY.
.npmrc

# Local environment template. .env.example carries corporate proxy/registry
# hostnames that must not be published in this PUBLIC repo; keep it local.
.env.example

# Artifacts written into the repo root by legacy Java middleware (UAMS) when a
# Java Vuser runs locally. They are runtime state, not source.
/uams.properties
/uams_mm.store
