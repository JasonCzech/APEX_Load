{
  "name": "Browser_Canary_Plus_Protocol_Load",
  "description": "Release-gate scenario template pairing protocol load with bounded browser canaries for UX evidence.",
  "scenario_mode": "vuser_driven",
  "duration": "20m",
  "claim_policy": "Browser VUsers are diagnostic canaries. High-density load comes from protocol groups.",
  "groups": [
    {
      "name": "Checkout HTTP Load",
      "script_path": "examples/web-api/ecommerce-http.json",
      "protocol": "http",
      "vusers": 1000,
      "ramp_up": "10m",
      "initialization": "at_runtime",
      "purpose": "Primary transaction throughput and SLA gate."
    },
    {
      "name": "Order Events WebSocket Load",
      "script_path": "examples/web-api/websocket-order-feed.json",
      "protocol": "websocket",
      "vusers": 150,
      "ramp_up": "5m",
      "initialization": "at_runtime",
      "purpose": "Protocol-side real-time dependency pressure."
    },
    {
      "name": "Desktop Checkout Browser Canary",
      "protocol": "browser",
      "vusers": 2,
      "ramp_up": "1m",
      "initialization": "at_runtime",
      "purpose": "Desktop UX screenshot, console, network, DOM, and Core Web Vitals evidence.",
      "benchmark_profile": "desktop_chromium_1080p",
      "script": {
        "name": "Desktop_Checkout_Browser_Canary",
        "version": "1.0.0",
        "protocol": "browser",
        "generated_by": "apexload-sample-pack",
        "generated_from": "browser-canary-template",
        "config": {
          "base_url": "https://shop.example.test",
          "browser": {
            "engine": "chromium",
            "device_profile": "desktop_1080p",
            "client_metrics": true,
            "capture_screenshots": "on_error"
          },
          "think_time": {
            "type": "fixed",
            "mean_ms": 750
          },
          "run_logic": {
            "iterations": 0,
            "auto_transactions": "per_action"
          },
          "error_handling": {
            "continue_on_error": false,
            "snapshot_on_error": true
          }
        },
        "actions": [
          {
            "name": "Open_Checkout",
            "type": "browser_navigate",
            "target": "/checkout",
            "wait_for": {
              "type": "selector",
              "value": "[data-testid='checkout-ready']",
              "timeout_ms": 10000
            }
          },
          {
            "name": "Confirm_Total_Visible",
            "type": "browser_wait",
            "selector": "[data-testid='order-total']",
            "wait_for": {
              "type": "selector",
              "value": "[data-testid='order-total']",
              "timeout_ms": 5000
            }
          }
        ]
      }
    },
    {
      "name": "Mobile Checkout Browser Canary",
      "protocol": "browser",
      "vusers": 1,
      "ramp_up": "1m",
      "initialization": "at_runtime",
      "purpose": "Mobile touch and Web Vitals evidence under protocol load.",
      "benchmark_profile": "mobile_chromium_pixel_8",
      "script": {
        "name": "Mobile_Checkout_Browser_Canary",
        "version": "1.0.0",
        "protocol": "browser",
        "generated_by": "apexload-sample-pack",
        "generated_from": "browser-canary-template",
        "config": {
          "base_url": "https://shop.example.test",
          "browser": {
            "engine": "chromium",
            "device_profile": "pixel_8",
            "touch_mode": true,
            "client_metrics": true,
            "capture_screenshots": "on_error"
          },
          "think_time": {
            "type": "fixed",
            "mean_ms": 1000
          },
          "run_logic": {
            "iterations": 0,
            "auto_transactions": "per_action"
          },
          "error_handling": {
            "continue_on_error": false,
            "snapshot_on_error": true
          }
        },
        "actions": [
          {
            "name": "Open_Mobile_Checkout",
            "type": "browser_navigate",
            "target": "/checkout",
            "wait_for": {
              "type": "selector",
              "value": "[data-testid='checkout-ready']",
              "timeout_ms": 10000
            }
          },
          {
            "name": "Tap_Payment_Method",
            "type": "browser_tap",
            "selector": "[data-testid='payment-method-card']",
            "wait_for": {
              "type": "selector",
              "value": "[data-testid='payment-method-card']",
              "timeout_ms": 5000
            }
          }
        ]
      }
    }
  ]
}
