      "body": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tns=\"urn:accounts\"><soapenv:Header/><soapenv:Body><tns:GetAccount><tns:accountId>{{data.accounts.account_id}}</tns:accountId></tns:GetAccount></soapenv:Body></soapenv:Envelope>",
      "soap": {
        "action": "urn:GetAccount",
        "operation": "GetAccount",
        "body_mode": "raw_xml"
