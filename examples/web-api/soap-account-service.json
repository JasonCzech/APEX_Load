{
  "name": "SOAP_Account_Service",
  "version": "1.0.0",
  "protocol": "soap",
  "generated_by": "stormrunner-sample-pack",
  "generated_from": "web-api-sample",
  "config": {
    "base_url": "https://soap.example.test/account",
    "think_time": {
      "type": "fixed",
      "mean_ms": 1000
    },
    "pacing": {
      "type": "none"
    },
    "soap": {
      "version": "1.1",
      "namespaces": {
        "tns": "urn:accounts"
      },
      "fault_handling": {
        "fail_on_fault": true
