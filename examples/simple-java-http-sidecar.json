{
  "script": {
    "name": "Simple_Java_HTTP_Byte_Preserving",
    "version": "1.0.0",
    "protocol": "java_http",

    "config": {
      "base_url": "https://gateway.example.test",
      "think_time": { "type": "fixed", "mean_ms": 1000 },
      "java_http": {
        "codec": "java_serialized_object_base64",
        "helper_mode": "embedded",
        "content_type": "application/x-java-serialized-object",
        "accept": "application/x-java-serialized-object",
        "body_encoding": "base64",
        "response_mapping": {
          "refreshToken": "nextToken"
        },
        "preserve_binary_result": true
      }
    },

    "actions": [
      {
        "name": "Refresh_Remote_Session",
        "type": "POST",
        "method": "POST",
        "target": "/java/session/refresh",
        "headers": {
          "X-Session-Trace": "{{fn.uuid()}}"
        },
        "body": "rO0ABXQAFXNlc3Npb24tcmVmcmVzaC1kdW1teQ==",
        "assertions": [
          { "type": "status_code", "expected": 200 }
        ],
        "think_time_after": true
      }
    ]
  }
}
