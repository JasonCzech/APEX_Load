{
  "script": {
    "name": "K8s_Distributed_Smoke",
    "version": "1.0.0",
    "protocol": "http",
    "config": {
      "base_url": "https://httpbin.org",
      "think_time": { "type": "fixed", "mean_ms": 250 }
    },
    "actions": [
      {
        "name": "GET_Smoke",
        "type": "GET",
        "target": "/get",
        "headers": { "Accept": "application/json" },
        "assertions": [
          { "type": "status_code", "expected": 200 },
          { "type": "response_time_ms", "max": 5000 }
        ],
        "think_time_after": true
      }
    ]
  }
}
