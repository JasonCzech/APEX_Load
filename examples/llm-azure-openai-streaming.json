{
  "name": "LLM Azure OpenAI Streaming (apexllm-target)",
  "version": "1.0.0",
  "protocol": "http",
  "config": {
    "base_url": "{{env.LLM_AZURE_OPENAI_ENDPOINT}}",
    "think_time": {
      "type": "fixed",
      "mean_ms": 250
    },
    "pacing": {
      "type": "none"
    },
    "run_logic": {
      "iterations": 1,
      "auto_transactions": "per_action"
    },
    "error_handling": {
      "max_retries": 3,
      "retry_delay_ms": 1000,
      "retry_backoff": "retry_after",
      "honor_retry_after": true,
      "retry_after_max_ms": 60000,
      "retry_on": [
        "429",
        "5xx"
      ]
    }
  },
  "actions": [
    {
      "name": "Azure OpenAI Chat Stream",
      "type": "llm_request",
      "method": "POST",
      "target": "/openai/deployments/{{env.LLM_AZURE_OPENAI_DEPLOYMENT}}/chat/completions?api-version=2024-10-21",
      "headers": {
        "api-key": "{{secret.AZURE_OPENAI_API_KEY}}",
        "Content-Type": "application/json",
        "Accept": "text/event-stream"
      },
      "body_template_encoding": "json",
      "body": "{\"messages\":[{\"role\":\"system\",\"content\":\"You are an enterprise assistant.\"},{\"role\":\"user\",\"content\":\"{{env.LLM_PROMPT}}\"}],\"max_tokens\":128,\"temperature\":0.2,\"stream\":true,\"stream_options\":{\"include_usage\":true}}",
      "params": {
        "llm_dialect": "azure_openai",
        "stream_mode": "sse",
        "model": "{{env.LLM_AZURE_OPENAI_DEPLOYMENT}}",
        "include_usage": true,
        "save_text_as": "assistant_reply"
      },
      "assertions": [
        {
          "type": "status_code",
          "expected": 200
        }
      ]
    }
  ]
}
