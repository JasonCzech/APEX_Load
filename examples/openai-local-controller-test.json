{
  "name": "OpenAI API Poll Local Controller",
  "duration": "5m",
  "script_shakeout": true,
  "resource_baseline": true,
  "assignment": {
    "mode": "auto"
  },
  "groups": [
    {
      "name": "openai-pollers",
      "script_id": "REPLACE_WITH_UPLOADED_SCRIPT_ID",
      "vusers": 2,
      "ramp_up": "30s",
      "initialization": "at_runtime"
    }
  ],
  "runtime_settings": {
    "pacing": {
      "type": "fixed_interval",
      "interval_ms": 5000
    },
    "log_level": "standard",
    "auto_transactions": "per_action"
  }
}