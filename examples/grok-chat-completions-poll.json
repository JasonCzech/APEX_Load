{
  "script": {
    "name": "Grok_Chat_Completions_Poll",
    "version": "1.0.0",
    "protocol": "http",
    "config": {
      "base_url": "https://api.x.ai",
      "pacing": {
        "type": "fixed_interval",
        "interval_ms": 5000
      },
      "http": {
        "connect_timeout_ms": 30000,
        "request_timeout_ms": 120000,
        "user_agent": "Stormrunner-Grok-Example/1.0"
      }
    },
    "parameters": [
      {
        "name": "request_suffix",
        "type": "random_string",
        "update": "each_iteration",
        "length": 8
      }
    ],
    "actions": [
      {
        "name": "POST_Grok_Chat_Completions",
        "type": "http",
        "method": "POST",
        "target": "/v1/chat/completions",
        "headers": {
          "Authorization": "Bearer {{env.XAI_API_KEY}}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": "{\"model\":\"{{env.XAI_MODEL}}\",\"messages\":[{\"role\":\"system\",\"content\":\"You are a terse assistant used for Stormrunner load testing.\"},{\"role\":\"user\",\"content\":\"Reply with the single word pong. Request suffix: {{param.request_suffix}}\"}],\"max_tokens\":16,\"temperature\":0}",
        "extractors": [
          {
            "name": "grok_response_id",
            "source": "body",
            "type": "jsonpath",
            "expression": "$.id"
          }
        ],
        "assertions": [
          {
            "type": "status_code",
            "expected": 200
          },
          {
            "type": "response_time_ms",
            "max": 45000
          },
          {
            "type": "body_contains",
            "value": "\"choices\""
          }
        ]
      }
    ]
  }
}