{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "dashboard"
    },
    {
      "name": "dashboard-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "cwd": "dashboard",
      "env": {
        "APEXLOAD_API_PROXY": "http://localhost:8099"
      }
    },
    {
      "name": "controller",
      "runtimeExecutable": "./bin/controller",
      "runtimeArgs": [],
      "port": 8080
    },
    {
      "name": "controller-preview",
      "runtimeExecutable": "./bin/controller",
      "runtimeArgs": [],
      "port": 8099,
      "autoPort": false,
      "env": {
        "APEXLOAD_ADDR": ":8099"
      }
    }
  ]
}
