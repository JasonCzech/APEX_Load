[
  {
    "id": "host_cpu_percent",
    "name": "host_cpu_percent",
    "expression": "100 * (1 - avg by (job, instance) (rate(node_cpu_seconds_total{job=\"kube-state-metrics\",namespace=\"checkout\",mode=\"idle\"}[2m])))",
    "unit": "%",
    "semantics": "gauge",
    "allowed_labels": [
      "job",
      "instance"
    ],
    "min_series": 1,
    "freshness_expression": "min by (job, instance) (timestamp(node_cpu_seconds_total{job=\"kube-state-metrics\",namespace=\"checkout\",mode=\"idle\"}))",
    "max_sample_age_seconds": 90
  },
  {
    "id": "host_memory_percent",
    "name": "host_memory_percent",
    "expression": "100 * (1 - sum by (job, instance) (node_memory_MemAvailable_bytes{job=\"kube-state-metrics\",namespace=\"checkout\"}) / sum by (job, instance) (node_memory_MemTotal_bytes{job=\"kube-state-metrics\",namespace=\"checkout\"}))",
    "unit": "%",
    "semantics": "gauge",
    "allowed_labels": [
      "job",
      "instance"
    ],
    "min_series": 1,
    "freshness_expression": "min by (job, instance) (label_replace(timestamp(node_memory_MemAvailable_bytes{job=\"kube-state-metrics\",namespace=\"checkout\"}), \"apex_memory_operand\", \"0\", \"\", \"\") or label_replace(timestamp(node_memory_MemTotal_bytes{job=\"kube-state-metrics\",namespace=\"checkout\"}), \"apex_memory_operand\", \"1\", \"\", \"\"))",
    "max_sample_age_seconds": 90
  },
  {
    "id": "process_cpu_cores",
    "name": "process_cpu_cores",
    "expression": "sum by (job, instance) (rate(process_cpu_seconds_total{job=\"kube-state-metrics\",namespace=\"checkout\"}[2m]))",
    "unit": "cores",
    "semantics": "rate",
    "allowed_labels": [
      "job",
      "instance"
    ],
    "min_series": 1,
    "freshness_expression": "min by (job, instance) (timestamp(process_cpu_seconds_total{job=\"kube-state-metrics\",namespace=\"checkout\"}))",
    "max_sample_age_seconds": 90,
    "terminal_expression": "sum by (job, instance) (rate(process_cpu_seconds_total{job=\"kube-state-metrics\",namespace=\"checkout\"}[{{window.duration}}]))"
  },
  {
    "id": "process_memory_bytes",
    "name": "process_memory_bytes",
    "expression": "max by (job, instance) (process_resident_memory_bytes{job=\"kube-state-metrics\",namespace=\"checkout\"})",
    "unit": "bytes",
    "semantics": "gauge",
    "allowed_labels": [
      "job",
      "instance"
    ],
    "min_series": 1,
    "freshness_expression": "min by (job, instance) (timestamp(process_resident_memory_bytes{job=\"kube-state-metrics\",namespace=\"checkout\"}))",
    "max_sample_age_seconds": 90
  },
  {
    "id": "http_request_rate",
    "name": "http_request_rate",
    "expression": "sum by (job) (rate(http_requests_total{job=\"kube-state-metrics\",namespace=\"checkout\"}[2m]))",
    "unit": "requests/s",
    "semantics": "rate",
    "allowed_labels": [
      "job"
    ],
    "min_series": 1,
    "freshness_expression": "min by (job) (timestamp(http_requests_total{job=\"kube-state-metrics\",namespace=\"checkout\"}))",
    "max_sample_age_seconds": 90,
    "terminal_expression": "sum by (job) (rate(http_requests_total{job=\"kube-state-metrics\",namespace=\"checkout\"}[{{window.duration}}]))"
  },
  {
    "id": "go_heap_bytes",
    "name": "go_heap_bytes",
