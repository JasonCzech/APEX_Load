[
  {
    "name": "select_all array publishes exact and lowercase slots, not the plain name",
    "script": {
      "protocol": "http",
      "actions": [
        {"name": "offers", "type": "request", "method": "GET", "target": "/offers", "extractors": [{"name": "C_Body", "source": "body", "type": "regex", "expression": "(.*)"}]},
        {"name": "eval offers", "type": "source_json", "params": {"function": "lr_eval_json", "json_object": "offers", "buffer": "{{var.C_Body}}"}},
        {"name": "offer ids", "type": "source_json", "params": {"function": "lr_json_get_values", "json_object": "offers", "value_param": "C_OfferIds", "query": "$.offers[*].id", "select_all": "Yes", "save_param": "C_OfferIds", "save_all": true}},
        {"name": "use slots", "type": "request", "method": "GET", "target": "/offers/{{var.c_offerids_3}}?count={{var.c_offerids_count}}&first={{var.C_OfferIds_1}}"},
        {"name": "use plain name", "type": "request", "method": "GET", "target": "/offers/{{var.c_offerids}}"},
        {"name": "use folded slot", "type": "request", "method": "GET", "target": "/offers/{{var.C_OFFERIDS_2}}"}
      ]
    },
    "expected": {"missing": ["C_OFFERIDS_2", "c_offerids"], "blocking": [], "late_produced": []}
  },
  {
    "name": "lr_json_get_values without SelectAll is a scalar whatever save_all says",
    "script": {
      "protocol": "http",
      "actions": [
        {"name": "eval", "type": "source_json", "params": {"function": "lr_eval_json", "json_object": "doc", "buffer": "{{var.body}}"}},
        {"name": "name", "type": "source_json", "params": {"function": "lr_json_get_values", "json_object": "doc", "value_param": "C_Name", "query": "$.name", "save_all": true}},
        {"name": "use", "type": "request", "method": "GET", "target": "/{{var.C_Name}}/{{var.c_name}}/{{var.C_Name_1}}/{{var.C_Name_count}}"}
      ]
    },
    "seeded": {"body": "{\"name\":\"n\"}"},
    "expected": {"missing": ["C_Name_1", "C_Name_count"], "blocking": [], "late_produced": []}
  },
  {
    "name": "legacy Key=Value JSON args are read when json_object is empty",
