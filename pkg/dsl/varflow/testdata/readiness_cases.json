  {
    "name": "control_parallel isolates branches and publishes parallel.<branch>.<name>",
    "script": {
      "protocol": "http",
      "actions": [
        {"name": "lanes", "type": "control_parallel", "control": {"branches": [
          {"name": "left", "steps": [{"name": "login", "type": "request", "method": "GET", "target": "/login", "extractors": [{"name": "token", "source": "body", "type": "jsonpath", "expression": "$.token"}]}]},
          {"name": "right", "steps": [{"name": "peek", "type": "request", "method": "GET", "target": "/{{var.token}}/{{var.parallel.left.token}}"}]}
        ]}},
        {"name": "joined", "type": "request", "method": "GET", "target": "/{{var.parallel.left.token}}/{{var.token}}"}
      ]
    },
    "expected": {"missing": ["parallel.left.token", "token"], "blocking": [], "late_produced": ["parallel.left.token"]}
  },
  {
    "name": "a parallel join publishes extracted values, not source-step, OAuth or status writes",
    "script": {
      "protocol": "http",
      "actions": [
        {"name": "lanes", "type": "control_parallel", "control": {"branches": [
          {"name": "b", "steps": [
            {"name": "eval", "type": "source_json", "params": {"function": "lr_eval_json", "json_object": "doc", "buffer": "{\"id\":1}"}},
            {"name": "id", "type": "source_json", "params": {"function": "lr_json_get_values", "json_object": "doc", "value_param": "C_Id", "query": "$.id"}},
            {"name": "copy", "type": "source_parameter", "params": {"function": "lr_save_string", "args": ["x", "C_Copy"]}},
            {"name": "token", "type": "http_oauth2_token", "target": "https://auth.example.test/token", "params": {"save_as": "Orders", "token_url": "https://auth.example.test/token", "grant_type": "client_credentials"}},
            {"name": "status", "type": "source_message", "params": {"function": "lr_vuser_status_message", "format": "done", "status_message": true}},
            {"name": "login", "type": "request", "method": "GET", "target": "/login", "extractors": [{"name": "C_Token", "source": "body", "type": "jsonpath", "expression": "$.token"}]},
            {"name": "title", "type": "browser_evaluate_js", "target": "document.title"},
            {"name": "calc", "type": "native_javascript", "params": {"source": "return {total: 1}", "result_prefix": "calc"}}
          ]}
        ]}},
        {"name": "joined", "type": "request", "method": "GET", "target": "/{{var.parallel.b.C_Id}}/{{var.parallel.b.c_id}}/{{var.parallel.b.C_Copy}}/{{var.parallel.b.Orders}}/{{var.parallel.b.orders_token_type}}/{{var.parallel.b.vuser_status}}/{{var.parallel.b.C_Token}}/{{var.parallel.b.result}}/{{var.parallel.b.calc.total}}"}
      ]
    },
    "expected": {"missing": ["parallel.b.C_Copy", "parallel.b.C_Id", "parallel.b.Orders", "parallel.b.c_id", "parallel.b.orders_token_type", "parallel.b.vuser_status"], "blocking": [], "late_produced": []}
  },
  {
    "name": "a parallel join republishes what a branch extracts again and a nested join, not a freed value",
    "script": {
      "protocol": "http",
      "actions": [
        {"name": "login", "type": "request", "method": "GET", "target": "/login", "extractors": [{"name": "session", "source": "body", "type": "jsonpath", "expression": "$.session"}]},
        {"name": "lanes", "type": "control_parallel", "control": {"branches": [
          {"name": "a", "steps": [
            {"name": "refresh", "type": "request", "method": "GET", "target": "/refresh", "extractors": [{"name": "session", "source": "body", "type": "jsonpath", "expression": "$.session"}, {"name": "dropped", "source": "body", "type": "jsonpath", "expression": "$.dropped"}]},
            {"name": "free", "type": "source_parameter", "params": {"function": "lr_free_parameter", "args": ["dropped"]}},
            {"name": "inner", "type": "control_parallel", "control": {"branches": [
              {"name": "deep", "steps": [{"name": "deep", "type": "request", "method": "GET", "target": "/deep", "extractors": [{"name": "leaf", "source": "body", "type": "jsonpath", "expression": "$.leaf"}]}]}
            ]}}
          ]},
          {"name": "b", "steps": [{"name": "idle", "type": "request", "method": "GET", "target": "/idle"}]}
        ]}},
        {"name": "joined", "type": "request", "method": "GET", "target": "/{{var.session}}/{{var.parallel.a.session}}/{{var.parallel.b.session}}/{{var.parallel.a.dropped}}/{{var.parallel.a.parallel.deep.leaf}}"}
      ]
    },
    "expected": {"missing": ["parallel.a.dropped", "parallel.b.session"], "blocking": [], "late_produced": []}
  },
  {
    "name": "a value a branch writes is late produced only for uses that branch can reach",
