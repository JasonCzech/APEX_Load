            {"name": "login", "type": "request", "method": "GET", "target": "/login", "extractors": [{"name": "tok", "source": "body", "type": "jsonpath", "expression": "$.tok"}, {"name": "early", "source": "body", "type": "jsonpath", "expression": "$.early"}]}
          ]},
          {"name": "other", "steps": [
            {"name": "peek", "type": "request", "method": "GET", "target": "/peek/{{var.tok}}/{{var.later}}"}
