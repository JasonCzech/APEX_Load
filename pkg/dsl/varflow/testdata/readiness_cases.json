  {
    "name": "if without else does not promote; values from both branches do",
    "script": {
      "protocol": "http",
      "actions": [
        {"name": "maybe", "type": "control_if", "control": {"condition": {"left": "{{var.mode}}", "op": "eq", "right": "a"}, "steps": [
          {"name": "then", "type": "request", "method": "GET", "target": "/then", "extractors": [{"name": "only_then", "source": "body", "type": "regex", "expression": "(.*)"}]}
        ]}},
        {"name": "either", "type": "control_if", "control": {"condition": {"left": "{{var.mode}}", "op": "eq", "right": "a"}, "steps": [
          {"name": "then", "type": "request", "method": "GET", "target": "/then", "extractors": [{"name": "both", "source": "body", "type": "regex", "expression": "(.*)"}, {"name": "then_only", "source": "body", "type": "regex", "expression": "(.*)"}]}
        ], "else": [
          {"name": "else", "type": "request", "method": "GET", "target": "/else", "extractors": [{"name": "both", "source": "body", "type": "regex", "expression": "(.*)"}]}
        ]}},
        {"name": "after", "type": "request", "method": "GET", "target": "/{{var.only_then}}/{{var.both}}/{{var.then_only}}"}
      ]
    },
    "seeded": {"mode": "a"},
    "expected": {"missing": ["only_then", "then_only"], "blocking": [], "late_produced": ["only_then", "then_only"]}
  },
  {
    "name": "switch without default does not promote; with a default it does",
    "script": {
      "protocol": "http",
      "actions": [
        {"name": "no default", "type": "control_switch", "control": {"cases": [
          {"condition": {"left": "{{var.mode}}", "op": "eq", "right": "a"}, "steps": [{"name": "a", "type": "request", "method": "GET", "target": "/a", "extractors": [{"name": "picked", "source": "body", "type": "regex", "expression": "(.*)"}]}]},
          {"condition": {"left": "{{var.mode}}", "op": "eq", "right": "b"}, "steps": [{"name": "b", "type": "request", "method": "GET", "target": "/b", "extractors": [{"name": "picked", "source": "body", "type": "regex", "expression": "(.*)"}]}]}
        ]}},
        {"name": "with default", "type": "control_switch", "control": {"cases": [
          {"condition": {"left": "{{var.mode}}", "op": "eq", "right": "a"}, "steps": [{"name": "a", "type": "request", "method": "GET", "target": "/a", "extractors": [{"name": "chosen", "source": "body", "type": "regex", "expression": "(.*)"}]}]}
        ], "default": [{"name": "fallback", "type": "request", "method": "GET", "target": "/z", "extractors": [{"name": "chosen", "source": "body", "type": "regex", "expression": "(.*)"}]}]}},
        {"name": "after", "type": "request", "method": "GET", "target": "/{{var.picked}}/{{var.chosen}}"}
      ]
    },
    "seeded": {"mode": "a"},
    "expected": {"missing": ["picked"], "blocking": [], "late_produced": ["picked"]}
  },
  {
    "name": "loops promote outputs only when an iteration is guaranteed and scope their locals",
    "script": {
      "protocol": "http",
      "data_sources": [{"name": "rows", "type": "csv", "inline_data": "id\n1", "first_row_header": true}],
      "actions": [
        {"name": "fixed", "type": "control_loop", "control": {"count": 2, "steps": [
          {"name": "counted", "type": "request", "method": "GET", "target": "/count/{{var.loop_index}}", "extractors": [{"name": "counted", "source": "body", "type": "regex", "expression": "(.*)"}]}
        ]}},
        {"name": "pre-test", "type": "control_loop", "control": {"condition": {"left": "{{var.more}}", "op": "eq", "right": "yes"}, "steps": [
          {"name": "pretest", "type": "request", "method": "GET", "target": "/pre", "extractors": [{"name": "pretest", "source": "body", "type": "regex", "expression": "(.*)"}]}
        ]}},
        {"name": "post-test", "type": "control_loop", "control": {"condition": {"left": "{{var.more}}", "op": "eq", "right": "yes"}, "do_while": true, "steps": [
          {"name": "posttest", "type": "request", "method": "GET", "target": "/post", "extractors": [{"name": "posttest", "source": "body", "type": "regex", "expression": "(.*)"}]}
        ]}},
        {"name": "rows", "type": "control_loop", "control": {"for_each": {"source": "rows", "var": "row"}, "steps": [
          {"name": "per row", "type": "request", "method": "GET", "target": "/rows/{{var.row.id}}", "extractors": [{"name": "per_row", "source": "body", "type": "regex", "expression": "(.*)"}]}
        ]}},
        {"name": "zero", "type": "control_loop", "control": {"count": 0, "steps": [
          {"name": "never", "type": "request", "method": "GET", "target": "/never", "extractors": [{"name": "never", "source": "body", "type": "regex", "expression": "(.*)"}]}
        ]}},
        {"name": "after", "type": "request", "method": "GET", "target": "/{{var.counted}}/{{var.pretest}}/{{var.posttest}}/{{var.per_row}}/{{var.never}}/{{var.loop_index}}/{{var.row.id}}"}
      ]
    },
    "seeded": {"more": "yes"},
    "expected": {"missing": ["loop_index", "never", "per_row", "pretest", "row.id"], "blocking": [], "late_produced": ["never", "per_row", "pretest"]}
  },
  {
    "name": "a do_while condition is first read after a pass, so its body supplies it; a pre-test or for-each condition is read first",
    "script": {
      "protocol": "http",
      "data_sources": [{"name": "rows", "type": "csv", "inline_data": "id\n1", "first_row_header": true}],
      "actions": [
        {"name": "poll", "type": "control_loop", "control": {"condition": {"left": "{{var.status}}", "op": "ne", "right": "done"}, "do_while": true, "max_iterations": 5, "steps": [
          {"name": "status", "type": "request", "method": "GET", "target": "/status", "extractors": [{"name": "status", "source": "body", "type": "jsonpath", "expression": "$.status"}]}
        ]}},
        {"name": "pre-test", "type": "control_loop", "control": {"condition": {"left": "{{var.pending}}", "op": "eq", "right": "yes"}, "max_iterations": 5, "steps": [
          {"name": "pending", "type": "request", "method": "GET", "target": "/pending", "extractors": [{"name": "pending", "source": "body", "type": "jsonpath", "expression": "$.pending"}]}
        ]}},
        {"name": "rows", "type": "control_loop", "control": {"for_each": {"source": "rows", "var": "row", "condition": {"left": "{{var.row_state}}", "op": "eq", "right": "open"}}, "do_while": true, "steps": [
          {"name": "row state", "type": "request", "method": "GET", "target": "/rows/{{var.row.id}}", "extractors": [{"name": "row_state", "source": "body", "type": "jsonpath", "expression": "$.state"}]}
        ]}}
      ]
    },
    "expected": {"missing": ["pending", "row_state"], "blocking": [], "late_produced": ["pending", "row_state"]}
  },
  {
