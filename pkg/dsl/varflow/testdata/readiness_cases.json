        {"name": "group", "type": "http_sequence", "method": "SEQUENCE", "target": "/{{var.copied}}", "attribution": {"hierarchy_path": "Checkout/{{var.title}}", "page_name": "{{param.page}}"}, "params": {"execution_mode": "concurrent", "requests": [
