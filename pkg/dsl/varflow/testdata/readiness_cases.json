        {"name": "menu", "type": "request", "method": "GET", "target": "/stores/{{var.C_StoreId}}/menu"}
      ]
    },
    "expected": {"missing": ["C_StoreId"], "blocking": [], "late_produced": ["C_StoreId"]}
