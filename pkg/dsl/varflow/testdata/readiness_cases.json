        ]}, "metadata": {"raw_source": "{{var.shell_evidence}} {{param.shell_only}}"}},
        {"name": "sequence", "type": "http_sequence", "metadata": {"raw_source": "{{param.sequence_only}}"}, "params": {"requests": [
          {"name": "child", "type": "request", "method": "GET", "target": "/child", "metadata": {"raw_source": "{{var.child_evidence}} {{param.child_region}}"}}
        ]}}
      ]
