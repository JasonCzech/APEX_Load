        {"name": "pick", "type": "source_json", "params": {"function": "lr_json_get_values", "args": ["JsonObject=doc", "ValueParam=Picked", "QueryString=$.items[{{var.index}}]", "SelectAll=no"]}},
        {"name": "use", "type": "request", "method": "GET", "target": "/{{var.picked}}/{{var.Picked}}"}
      ]
    },
    "seeded": {"payload": "{}"},
    "expected": {"missing": ["index"], "blocking": ["index"], "late_produced": []}
  },
