          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def traceId = vars.get(&apos;idpTraceId&apos;) ?: &apos;NOT_FOUND&apos;
long latencyMs = prev.getLatency()

def outputFile = new File(&apos;C:/temp/traceId-results.csv&apos;)
outputFile.parentFile?.mkdirs()

synchronized (org.apache.jmeter.util.JMeterUtils.class) {
    boolean writeHeader = !outputFile.exists() || outputFile.length() == 0

    outputFile.withWriterAppend(&apos;UTF-8&apos;) { writer -&gt;
        if (writeHeader) {
            writer.writeLine(&apos;traceId,latencyMs&apos;)
        }
        writer.writeLine(&quot;${traceId},${latencyMs}&quot;)
    }
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
