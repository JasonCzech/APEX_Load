# Experimental facade only: no Java, facade/generator credentials or signing
# keys are baked into this image. Supply operator configuration at runtime.
FROM golang:1.26.5-alpine3.24@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder
WORKDIR /src
COPY go.mod go.sum ./
COPY third_party/playwright-go/ ./third_party/playwright-go/
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" \
    -o /apexload-java-host-facade ./cmd/apexload-java-host-facade

FROM scratch
COPY --from=builder /apexload-java-host-facade /apexload-java-host-facade
USER 10001:10001
EXPOSE 8092
ENTRYPOINT ["/apexload-java-host-facade"]
# Run beside the generator on loopback with read-only TLS/token mounts.
# No Kubernetes credentials or host issuer key may be mounted here.
