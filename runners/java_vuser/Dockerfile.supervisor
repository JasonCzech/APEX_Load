# Experimental execution-host base. Derive a digest-pinned workload image that
# adds /assets/java-host.json and its approved JAR assets. Never bake secrets in.
FROM golang:1.26.9-alpine3.24@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS go-builder
WORKDIR /src
COPY go.mod go.sum ./
COPY third_party/playwright-go/ ./third_party/playwright-go/
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" \
    -o /apexload-java-host-supervisor ./cmd/apexload-java-host-supervisor

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS harness-builder
RUN apk add --no-cache openjdk21-jdk
WORKDIR /src
COPY runners/java_vuser/Harness.java ./Harness.java
COPY runners/java_vuser/apexload/ ./apexload/
COPY runners/java_vuser/lrapi/lr.java ./lrapi/lr.java
RUN mkdir /classes \
    && javac --release 17 -d /classes lrapi/lr.java Harness.java apexload/data/*.java apexload/bridge/Native*.java \
    && jar --create --file /harness.jar --main-class Harness -C /classes .

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates openjdk21-jre-headless \
    && mkdir -p /assets /scratch /transport \
    && chown 10001:10001 /scratch
COPY --from=go-builder /apexload-java-host-supervisor /apexload-java-host-supervisor
COPY --from=harness-builder /harness.jar /assets/harness.jar
ENV TMPDIR=/scratch
WORKDIR /scratch
USER 10001:10001
EXPOSE 9443
ENTRYPOINT ["/apexload-java-host-supervisor"]
# Launch only with a read-only root, dropped ALL capabilities, no-new-privileges,
# private PID namespace, bounded scratch, and a read-only host transport mount.
# The constructor refuses ordinary/non-Linux processes. No broker/Kubernetes
# credentials belong in this image. Container termination needs external proof.
