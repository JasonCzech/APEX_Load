# Experimental broker only: no Java, facade/generator credentials or signing
# keys are baked into this image. Supply operator configuration at runtime.
FROM golang:1.26.9-alpine3.24@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS builder
WORKDIR /src
COPY go.mod go.sum ./
COPY third_party/playwright-go/ ./third_party/playwright-go/
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" \
    -o /apexload-java-host-broker ./cmd/apexload-java-host-broker

FROM scratch
COPY --from=builder /apexload-java-host-broker /apexload-java-host-broker
USER 10001:10001
EXPOSE 9444
ENTRYPOINT ["/apexload-java-host-broker"]
# Use a read-only root and a separately protected persistent /state mount.
# Only this broker receives namespace-scoped pod/Secret permissions. Never mount
# its signing key, client key, Kubernetes token or state into execution pods.
