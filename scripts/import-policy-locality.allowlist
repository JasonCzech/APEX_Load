# pkg/convert/openapi/converter.go
# VERIFIED 2026-07-27 -- do not re-investigate:
#   - openAPISharedCredentialProjectionSafe gates on five reason codes that
#     exist only in this package, so there is nothing to centralize.
#   - openAPISecretName / openAPICredentialReference hand-roll a name grammar
#     with no length bound and CAN emit names credential.NormalizeLogicalName
#     rejects (>249 chars). That is not a live defect: the shared
#     credentialpolicy.NewNameRegistry re-mints them downstream and
#     disambiguates collisions -- two 300-char scheme names produced
#     OPENAPI_TOKEN and OPENAPI_TOKEN_DCA2F48CF572, not a collision.
#     Centralizing them would rename secrets users have already bound, which
#     is a breaking change rather than a refactor.
#   - The remainder are OpenAPI schema concepts (format: password, OAuth
#     scopes, schema-derived example zeroing) with no cross-format equivalent.
policy:pkg/convert/openapi/converter.go:ensureOAuthToken
policy:pkg/convert/openapi/converter.go:openAPICredentialReference
policy:pkg/convert/openapi/converter.go:openAPIEffectiveAuth
policy:pkg/convert/openapi/converter.go:openAPIPreGovernedHeaderOccurrences
policy:pkg/convert/openapi/converter.go:openAPISchemaCredentialNames
policy:pkg/convert/openapi/converter.go:openAPISecretName
