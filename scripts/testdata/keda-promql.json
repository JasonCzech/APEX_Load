{
  "evaluation_interval": "15s",
  "tests": [
    {
      "name": "HA duplicates, stale followers, separate fleets, and expiry",
      "interval": "15s",
      "input_series": [
        {
          "series": "apexload_fleet_autoscaling{fleet=\"fleet-a\",job=\"controller\",instance=\"leader\",signal=\"total_vusers\"}",
          "values": "180+0x10"
        },
        {
          "series": "apexload_fleet_autoscaling{fleet=\"fleet-a\",job=\"controller\",instance=\"leader\",signal=\"active_vusers\"}",
          "values": "180+0x10"
        },
        {
          "series": "apexload_fleet_autoscaling{fleet=\"fleet-a\",job=\"controller\",instance=\"leader\",signal=\"reserved_replica_floor\"}",
          "values": "9+0x10"
        },
        {
          "series": "apexload_fleet_autoscaling{fleet=\"fleet-a\",job=\"controller\",instance=\"leader\",signal=\"total_browser_vusers\"}",
          "values": "15+0x10"
        },
        {
          "series": "apexload_fleet_autoscaling{fleet=\"fleet-a\",job=\"controller\",instance=\"leader\",signal=\"active_browser_vusers\"}",
          "values": "10+0x10"
        },
        {
          "series": "apexload_fleet_autoscaling{fleet=\"fleet-a\",job=\"controller\",instance=\"leader\",signal=\"saturated_generators\"}",
          "values": "5+0x10"
        },
        {
          "series": "apexload_fleet_autoscaling_valid_until{fleet=\"fleet-a\",job=\"controller\",instance=\"leader\"}",
          "values": "120+0x10"
        },
        {
          "series": "apexload_fleet_autoscaling{fleet=\"fleet-a\",job=\"controller\",instance=\"duplicate-scrape\",signal=\"total_vusers\"}",
