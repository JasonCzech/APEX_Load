[Desktop Entry]
Type=Application
Name=APEX Load
GenericName=Performance Testing Platform
Comment=Enterprise performance testing platform
Exec=apexload %U
Icon=apexload
Terminal=false
Categories=Development;
StartupNotify=true
StartupWMClass=apexload
# Register the apexload:// deep-link scheme and the vendor-specific HAR type.
# We intentionally do NOT claim application/json, which would hijack every JSON
# document on the system.
MimeType=x-scheme-handler/apexload;application/x-apexload-har;
