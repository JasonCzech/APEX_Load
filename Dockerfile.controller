ARG PLAYWRIGHT_DRIVER_VERSION=1.61.1

FROM node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS dashboard-builder

ARG PLAYWRIGHT_DRIVER_VERSION
ARG VERSION=dev
ARG BUILD_TIME=

WORKDIR /src
COPY dashboard/package.json dashboard/package-lock.json ./dashboard/
COPY dashboard/scripts/check-node-version.mjs ./dashboard/scripts/check-node-version.mjs
# check-node-version.mjs resolves the pin from ../../.nvmrc, i.e. /src/.nvmrc.
# It must be copied alongside the script: without it the preinstall gate below
# throws ENOENT and the image build fails before npm ci ever runs.
COPY .nvmrc ./.nvmrc
RUN npm --prefix dashboard run check:node
RUN npm --prefix dashboard ci --ignore-scripts
RUN actual="$(node -p "require('./dashboard/node_modules/playwright-core-go/package.json').version")" \
	&& test "${actual}" = "${PLAYWRIGHT_DRIVER_VERSION}" \
	|| { echo "locked playwright-core driver ${actual} does not match ${PLAYWRIGHT_DRIVER_VERSION}" >&2; exit 1; }
# Help & documentation articles are bundled into the dashboard by
# dashboard/src/helpContent.ts's import.meta.glob() at build time, resolved
# against whatever exists on disk in THIS stage — not the full repo checkout.
# Copy every doc path the help catalog can reference (docs/help-content-catalog.json),
# not just a hand-picked few, or articles silently go missing from the built bundle
# while still working in `npm run dev` (which sees the whole repo).
COPY docs/*.md ./docs/
COPY docs/help-content-catalog.json docs/dsl.schema.json ./docs/
COPY pkg/api/import_settings_fields.json ./pkg/api/import_settings_fields.json
COPY mcp/README.md ./mcp/README.md
COPY deployments/README.md ./deployments/README.md
COPY deployments/docker/ ./deployments/docker/
COPY deployments/helm/ ./deployments/helm/
COPY deployments/k8s/ ./deployments/k8s/
COPY dashboard/ ./dashboard/
# The dashboard build deliberately writes to /src/pkg/api/static, matching the
# go:embed path used by the controller. Building it here makes image contents
# independent from any locally generated or committed frontend bundle.
RUN APEXLOAD_UX_VERSION="${VERSION}" APEXLOAD_UX_BUILD_TIME="${BUILD_TIME}" \
	npm --prefix dashboard run build

FROM golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c AS builder

WORKDIR /src
COPY go.mod go.sum ./
COPY third_party/playwright-go/ ./third_party/playwright-go/
RUN go mod download
COPY . .
COPY --from=dashboard-builder /src/pkg/api/static/ ./pkg/api/static/

ARG BINARY=controller
ARG GO_BUILD_TAGS=standard
ARG VERSION=dev
ARG COMMIT=
ARG BUILD_TIME=
ARG BI=github.com/jasonczech/apexload/pkg/buildinfo
RUN case "${GO_BUILD_TAGS}" in \
		standard) build_tags="analytics_duckdb" ;; \
		enterprise) build_tags="analytics_duckdb,jms_solace_real,jms_servicebus_real,kafka_real,eventhubs_real" ;; \
		*) echo "unsupported GO_BUILD_TAGS profile: ${GO_BUILD_TAGS} (expected standard or enterprise)" >&2; exit 2 ;; \
	esac \
	&& if [ -n "${build_tags}" ]; then set -- -tags "${build_tags}"; else set --; fi \
	&& test "${BINARY}" = controller \
	&& CGO_ENABLED=1 GOOS=linux go build -trimpath "$@" \
		-ldflags "-s -w -X ${BI}.Version=${VERSION} -X ${BI}.Commit=${COMMIT} -X ${BI}.BuildTime=${BUILD_TIME}" \
		-o /app ./cmd/${BINARY}

# Debian 13: Debian 12's glib, sqlite, OpenSSL and util-linux carry HIGH and
# CRITICAL findings with no Debian 12 fix, which Debian 13's builds have
# fewer of or none. The build stages stay on Debian 12: Node and the
# DuckDB-linked controller run on the newer glibc and libstdc++.
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
ARG BINARY=controller
ARG PLAYWRIGHT_DRIVER_VERSION
# DuckDB's pinned Linux libraries require glibc and libstdc++; generators
# retain the independent CGO-free Alpine build in Dockerfile.
# The upgrade applies Debian security fixes released after the pinned base digest.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends ca-certificates libstdc++6 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
# Reuse the pinned glibc Node runtime; Debian's nodejs package is older.
COPY --from=dashboard-builder /usr/local/bin/node /usr/bin/node
COPY --from=dashboard-builder /src/dashboard/node_modules/playwright-core-go/ /opt/playwright-driver/package/
RUN if [ "$BINARY" = "generator" ] || [ "$BINARY" = "controller" ]; then \
		actual="$(node /opt/playwright-driver/package/cli.js --version)"; \
		test "${actual}" = "Version ${PLAYWRIGHT_DRIVER_VERSION}" \
		|| { echo "runtime Playwright driver ${actual} does not match Version ${PLAYWRIGHT_DRIVER_VERSION}" >&2; exit 1; }; \
	fi
# Recording and Verify run the Chromium builds the Playwright driver pins
# (browsers.json), the same as browser generators (Dockerfile.browser-generator),
# installed with their system libraries into a path any uid can read.
# Playwright's dependency list also brings Xvfb for headed runs. Nothing in
# the image starts an X server and headless Chromium needs none, so Xvfb is
# removed again rather than shipped unused.
# PLAYWRIGHT_DOWNLOAD_HOST names a mirror of Playwright's browser CDN for
# builders that cannot reach it.
ARG PLAYWRIGHT_DOWNLOAD_HOST
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN if [ -z "${PLAYWRIGHT_DOWNLOAD_HOST:-}" ]; then unset PLAYWRIGHT_DOWNLOAD_HOST; fi \
	&& node /opt/playwright-driver/package/cli.js install --with-deps chromium \
	&& apt-get purge -y --auto-remove xvfb xserver-common \
	&& chmod -R a+rX /ms-playwright \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=builder /app /usr/local/bin/app
# Browser runtime wiring (controller and generator images; inert elsewhere):
# - the driver lives at a fixed path readable by any uid (readOnlyRootFilesystem-safe)
# - Playwright launches its own Chromium: APEXLOAD_BROWSER_EXECUTABLE stays unset
# - HOME gives uid 65532 (no passwd entry) a writable scratch root under /tmp
ENV PLAYWRIGHT_DRIVER_PATH=/opt/playwright-driver \
	PLAYWRIGHT_NODEJS_PATH=/usr/bin/node \
	APEXLOAD_ADDR=0.0.0.0:8080 \
	HOME=/tmp
RUN mkdir -p /data /tmp /opt/playwright-driver /var/lib/apexload-bruno \
	&& chown -R 65532:65532 /data /tmp /var/lib/apexload-bruno
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/app"]
