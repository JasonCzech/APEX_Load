  "cases": [
    {
      "id": "bruno-attached-preservation",
      "scope": "Byte preservation, variables, headers, body and scripts across three attached SOAP sources",
      "source_kind": "repository-attached",
      "sources": [
        "pkg/convert/bruno/attached_acceptance_test.go",
        "pkg/convert/bruno/testdata/attached/ActivateSubscriber_v302.yml",
        "pkg/convert/bruno/testdata/attached/AddSalesTransactionDetails_v302.yml",
        "pkg/convert/bruno/testdata/attached/ExecuteUnifiedCreditPolicyCheck_v246.yml"
      ],
      "expectations": [
        "No dropped items; original source bytes preserved; credential projection accounted for"
      ],
      "command": [
        "go",
        "test",
        "-json",
        "-count=1",
        "-timeout=5m",
        "./pkg/convert/bruno",
        "-run",
        "^TestAttachedOpenCollectionSOAPRequestsImportLosslessly$"
      ]
    },
