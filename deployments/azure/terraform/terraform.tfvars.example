# Copy to terraform.tfvars and adjust. Everything has a sane default; the
# common overrides are listed here.

prefix      = "apexload"
environment = "prod"
location    = "eastus2"

# Production default: private endpoints/private DNS for PostgreSQL, Redis,
# Storage, and Key Vault. Use "public" only for evaluation environments.
# network_mode = "private"

# Lock down the AKS API server to your network egress.
# authorized_ip_ranges = ["203.0.113.0/24"]

# Keep AKS pools zonal where the selected region supports zones.
# availability_zones = ["1", "2", "3"]

# Add enterprise Entra groups for AKS Azure RBAC administration. The current
# Terraform principal is granted bootstrap Cluster Admin by default.
# aks_admin_group_object_ids = ["00000000-0000-0000-0000-000000000000"]

# If network_mode = "public", restrict public Storage/Key Vault access to
# trusted egress CIDRs. Empty keeps evaluation-mode public endpoints open.
# public_network_allowed_cidrs = ["203.0.113.0/24"]

# Allow your workstation/CI through the PostgreSQL firewall during migration.
# postgres_allowed_cidrs = {
#   office = "203.0.113.0/24"
# }

# Generator capacity: terraform plan validates KEDA max replicas against pod
# requests, VM size, node count, and kube/system reservations. The defaults fit
# the 50-pod KEDA ceiling on Standard_D4s_v5 after a conservative 25% reservation.
# generator_node_vm_size           = "Standard_D4s_v5"
# generator_node_max_count         = 17
# generator_keda_max_replicas      = 50
# generator_pod_cpu_millicores     = 1000
# generator_pod_memory_mib         = 2048
# generator_node_reserved_fraction = 0.25

tags = {
  owner = "performance-engineering"
}
