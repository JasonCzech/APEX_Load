{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "registry": { "$ref": "#/definitions/nonPlaceholder" },
        "tag": { "type": "string", "minLength": 1 },
        "controllerRepository": { "type": "string", "minLength": 1 },
        "generatorRepository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "dataPlatform": {
      "type": "object",
      "properties": {
        "azureStorageAccount": {
          "type": "string",
          "pattern": "^[a-z0-9]{3,24}$",
          "not": { "pattern": "(changeme|CHANGE-ME|change-me)" }
        },
        "keyVaultUrl": {
          "type": "string",
          "format": "uri",
          "not": { "pattern": "(changeme|CHANGE-ME|change-me)" }
        },
        "azureMessagingAllowedNamespaces": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9.-]+(?:,[A-Za-z0-9.-]+)*$"
        },
        "createSecret": { "type": "boolean" },
        "databaseUrl": { "type": "string" },
        "redisUrl": { "type": "string" },
        "grpcAuthToken": { "type": "string" }
      }
    },
    "projectSecrets": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": ["database", "azure_key_vault"]
        },
        "wrappingMasterKey": {
          "type": "string"
        },
        "wrappingKeyVaultKeyId": {
          "type": "string",
          "pattern": "^$|^https://[^/]+/keys/[^/]+/[^/]+$"
        },
        "azureKeyVaultApiVersion": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?:-preview)?$"
        }
      },
      "required": ["provider", "azureKeyVaultApiVersion"]
    },
    "workloadIdentity": {
      "type": "object",
      "properties": {
        "importEnabled": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "controllerClientId": { "type": "string" },
        "generatorClientId": { "type": "string" }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "publicURL": {
          "type": "string",
          "pattern": "^$|^https://\\S+$"
        },
        "ciOIDCAudience": {
          "type": "string",
          "pattern": "^$|^[^\\s\\x00-\\x1F\\x7F]{1,512}$"
        },
        "ha": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "endpointAddressType": { "enum": ["IPv4", "IPv6"] }
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "properties": {
        "statePersistence": {
          "type": "object",
          "properties": {
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
              }
            },
            "storageClassName": { "type": "string" },
            "size": { "type": "string", "minLength": 1 }
          },
          "required": ["accessModes", "size"]
        }
      }
    },
    "bruno": {
      "type": "object",
      "properties": {
        "importEnabled": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "compatibilityVersion": { "const": "3.5.2" },
        "artifactRoot": { "type": "string", "pattern": "^/" },
        "artifactPersistence": {
          "type": "object",
          "properties": {
            "existingClaim": { "type": "string" }
          },
          "required": ["existingClaim"]
        },
        "keyVaultKeyId": {
          "type": "string",
          "pattern": "^$|^https://[^/]+/keys/[^/]+/[^/]+$"
        },
        "artifactMasterKey": { "type": "string" },
        "egressBrokerUrl": {
          "type": "string",
          "pattern": "^$|^http://[^\\s]+$"
        },
        "allowDirectEgress": { "type": "boolean" },
        "maxSessions": { "type": "integer", "minimum": 1 },
        "maxPendingEvents": { "type": "integer", "minimum": 1 },
        "maxBundleBytes": { "type": "integer", "minimum": 65536 },
        "sessionTtlMs": { "type": "integer", "minimum": 1 },
        "sessionIdleTtlMs": { "type": "integer", "minimum": 1 },
        "maxJumps": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxRunRequestDepth": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maxParallelRequests": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxOutputBytes": { "type": "integer", "minimum": 65536, "maximum": 1073741824 },
        "maxStreamTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "runner": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string" },
                "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(example\\.com|changeme|CHANGE-ME|change-me)" }
        }
      }
    },
    "keda": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicaCount": { "type": "integer", "minimum": 0 },
        "maxReplicaCount": { "type": "integer", "minimum": 1 },
        "azureMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "identityId": { "type": "string" },
            "serverAddress": { "type": "string" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "bruno": {
            "properties": {
              "importEnabled": { "const": true }
            },
            "required": ["importEnabled"]
          }
        }
      },
      "then": {
        "properties": {
          "bruno": {
            "properties": {
              "artifactPersistence": {
                "properties": {
                  "existingClaim": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "bruno": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "bruno": {
            "properties": {
              "artifactPersistence": {
                "properties": {
                  "existingClaim": { "type": "string", "minLength": 1 }
                }
              }
            },
            "anyOf": [
              {
                "properties": {
                  "egressBrokerUrl": { "type": "string", "minLength": 1 }
                }
              },
              {
                "properties": {
                  "allowDirectEgress": { "const": true }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "controller": {
            "properties": {
              "replicas": { "minimum": 2 }
            },
            "required": ["replicas"]
          }
        },
        "required": ["controller"]
      },
      "then": {
        "properties": {
          "controller": {
            "properties": {
              "ha": {
                "properties": {
                  "enabled": { "const": true }
                },
                "required": ["enabled"]
              }
            },
            "required": ["ha"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workloadIdentity": {
            "properties": { "enabled": { "const": true } }
          }
        }
      },
      "then": {
        "properties": {
          "workloadIdentity": {
            "properties": {
              "controllerClientId": { "$ref": "#/definitions/nonPlaceholder" },
              "generatorClientId": { "$ref": "#/definitions/nonPlaceholder" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": { "enabled": { "const": true } }
          }
        }
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "host": { "$ref": "#/definitions/nonPlaceholder" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "keda": {
            "properties": {
              "azureMonitor": {
                "properties": { "enabled": { "const": true } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "keda": {
            "properties": {
              "azureMonitor": {
                "properties": {
                  "identityId": { "$ref": "#/definitions/nonPlaceholder" },
                  "serverAddress": { "$ref": "#/definitions/nonPlaceholder" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "nonPlaceholder": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(changeme|CHANGE-ME|change-me|example\\.com|\\$\\{[A-Z0-9_]+\\})"
      }
    }
  }
}
