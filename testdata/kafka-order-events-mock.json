{
  "name": "Kafka Order Events (mock)",
  "version": "1.0.0",
  "protocol": "kafka",
  "config": {
    "think_time": { "type": "fixed", "mean_ms": 500 },
    "pacing": { "type": "none" },
    "run_logic": { "iterations": 0, "auto_transactions": "none" },
    "error_handling": { "continue_on_error": false },
    "log": { "level": "standard" },
    "kafka": {
      "brokers": [],
      "security_protocol": "plaintext",
      "topic": "orders.events",
      "consumer_group": "apexload-orders",
      "acks": "all",
      "compression": "none",
      "partition_strategy": "key-hash",
      "auto_offset_reset": "latest",
      "timeout_ms": 5000,
      "mock": true
    }
  },
  "actions": [
    {
      "name": "Produce_Order_Created",
      "type": "kafka_produce",
      "target": "orders.events",
      "params": { "key": "{{fn.uuid()}}" },
      "body": "{\"orderId\":\"{{fn.uuid()}}\",\"status\":\"created\"}",
      "assertions": [
        { "type": "offset_advanced" }
      ],
      "think_time_after": true
    },
    {
      "name": "Consume_Order_Created",
      "type": "kafka_consume",
      "target": "orders.events",
      "params": { "timeout_ms": 5000 },
      "extractors": [
        { "name": "order_id", "source": "body", "type": "jsonpath", "expression": "$.orderId" }
      ],
      "assertions": [
        { "type": "message_received" },
        { "type": "body_contains", "value": "created" },
        { "type": "consumer_lag_below", "max": 100 }
      ],
      "think_time_after": true
    }
  ]
}
